#!/usr/bin/ucode
'use strict';

import { readfile, glob, popen } from 'fs';

function temperature(path) {
	let v = trim(readfile(path) || '');
	return v ? (+v / 1000) : null;
}

function emcRegister(reg) {
	let pipe = popen(sprintf('/usr/sbin/i2cget -y 9 0x2f 0x%02x 2>/dev/null', reg), 'r');
	if (!pipe)
		return null;
	let value = trim(pipe.read('all') || '');
	let code = pipe.close();
	return code == 0 && match(value, /^0x[0-9a-fA-F]{2}$/) ? hex(value) : null;
}

function status() {
	let sensors = [];
	for (let h in glob('/sys/class/hwmon/hwmon*')) {
		let name = trim(readfile(h + '/name') || '');
		if (name != 'coretemp' && name != 'ath10k_hwmon')
			continue;
		for (let p in glob(h + '/temp*_input')) {
			let value = temperature(p);
			if (value != null)
				push(sensors, {
					source: name == 'coretemp' ? 'cpu' : 'wifi',
					sensor: substr(p, rindex(p, '/') + 1),
					label: trim(readfile(replace(p, /_input$/, '_label')) || ''),
					value: value
				});
		}
	}
	// EMC2104 is accessed through i2c-dev, not registered as a hwmon device.
	if (emcRegister(0xfd) == 0x1d) {
		for (let reg in [0x00, 0x02, 0x04]) {
			let high = emcRegister(reg);
			let low = emcRegister(reg + 1);
			if (high == null || low == null || high == 0x80)
				continue;
			push(sensors, {
				source: 'emc',
				sensor: sprintf('0x%02x', reg),
				value: (high > 127 ? high - 256 : high) + (low >> 5) * 0.125
			});
		}
	}
	let duty = trim(readfile('/tmp/velo5x0-fan.duty') || '');
	return {
		running: system('/etc/init.d/velo5x0-fan status >/dev/null 2>&1') == 0,
		duty: duty ? +duty : null,
		sensors: sensors
	};
}

return {
	'luci.velo5x0_fan': {
		status: { call: status }
	}
};
